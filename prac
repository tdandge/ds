import java.util.Scanner;

public class Berkeley {

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        // Step 1: Input number of processes (including master)
        System.out.print("Enter number of processes (including master process): ");
        int numProcesses = input.nextInt();

        int[] clockTimes = new int[numProcesses]; // Array to store current clock times
        int[] timeDifferences = new int[numProcesses]; // Differences from master

        // Step 2: Input current clock times of all processes
        System.out.println("Enter clock times (in seconds) for each process:");
        for (int i = 0; i < numProcesses; i++) {
            System.out.print("Process " + i + ": ");
            clockTimes[i] = input.nextInt();
        }

        // Step 3: Assume process 0 is the master
        int masterClock = clockTimes[0];
        int totalDifference = 0;

        // Step 4: Calculate time differences and total (excluding master)
        for (int i = 1; i < numProcesses; i++) {
            timeDifferences[i] = clockTimes[i] - masterClock;
            totalDifference += timeDifferences[i];
        }

        // Step 5: Compute average difference
        int averageDifference = totalDifference / (numProcesses - 1);

        System.out.println("\nMaster clock: " + masterClock + " seconds");
        System.out.println("Total difference (excluding master): " + totalDifference + " seconds");
        System.out.println("Average adjustment: " + averageDifference + " seconds\n");

        // Step 6: Compute new times
        System.out.println("Synchronized clock times:");
        for (int i = 0; i < numProcesses; i++) {
            if (i == 0) {
                // Adjust master clock too (optional)
                clockTimes[i] += averageDifference;
            } else {
                // Adjust each clock by (average - its offset from master)
                clockTimes[i] += (averageDifference - timeDifferences[i]);
            }
            System.out.println("Process " + i + ": " + clockTimes[i] + " seconds");
        }
    }
    }


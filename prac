import java.util.*;

class Process {
    int id;
    boolean active;

    Process(int id) {
        this.id = id;
        this.active = true;
    }
}

public class BullyAlgorithm {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of processes: ");
        int n = sc.nextInt();
        Process[] processes = new Process[n];

        // Input process IDs
        for (int i = 0; i < n; i++) {
            System.out.print("Enter ID for process " + i + ": ");
            processes[i] = new Process(sc.nextInt());
        }

        // Find and simulate failure of highest ID process
        int maxID = -1, maxIndex = -1;
        for (int i = 0; i < n; i++) {
            if (processes[i].id > maxID) {
                maxID = processes[i].id;
                maxIndex = i;
            }
        }
        processes[maxIndex].active = false;
        System.out.println("Process with ID " + maxID + " has failed.");

        // Start election from user-specified process
        System.out.print("Enter index of process to start election: ");
        int starter = sc.nextInt();
        if (!processes[starter].active) {
            System.out.println("Selected process is inactive. Cannot start election.");
            return;
        }

        System.out.println("Process " + processes[starter].id + " is starting election...");
        int coordinatorID = -1;
        for (Process p : processes) {
            if (p.active && p.id > processes[starter].id) {
                System.out.println("Process " + processes[starter].id + " sends message to " + p.id);
            }
        }

        // Elect highest active process as coordinator
        for (Process p : processes) {
            if (p.active && p.id > coordinatorID) {
                coordinatorID = p.id;
            }
        }

        System.out.println("New Coordinator is Process with ID " + coordinatorID);
        sc.close();
    }
}


import java.util.*;

public class Ring {
    static class Process {
        int id;
        boolean isActive;

        Process(int id) {
            this.id = id;
            this.isActive = true;
        }
    }

    static int n; // number of processes
    static Process[] processes;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input number of processes
        System.out.print("Enter number of processes: ");
        n = sc.nextInt();
        processes = new Process[n];

        // Input process IDs
        System.out.println("Enter process IDs:");
        for (int i = 0; i < n; i++) {
            int id = sc.nextInt();
            processes[i] = new Process(id);
        }

        // Input initiator of election
        System.out.print("Enter the index of process initiating election (0 to " + (n-1) + "): ");
        int initiator = sc.nextInt();

        if (!processes[initiator].isActive) {
            System.out.println("Initiator process is not active.");
            return;
        }

        int electedLeader = ringElection(initiator);
        System.out.println("Leader elected with Process ID: " + electedLeader);
    }

    static int ringElection(int initiator) {
        List<Integer> electionMessage = new ArrayList<>();
        int current = initiator;

        do {
            if (processes[current].isActive) {
                electionMessage.add(processes[current].id);
            }
            current = (current + 1) % n;
        } while (current != initiator);

        int leaderId = Collections.max(electionMessage);

        // Broadcasting coordinator message
        System.out.println("Election Message: " + electionMessage);
        System.out.println("Broadcasting Coordinator Message with Leader ID: " + leaderId);

        return leaderId;
    }
}

